-- Save original values so OFF can restore them
local enabled = false
local saved = {}
local savedLighting = {}

local function saveProperty(obj, property)
    local ok, value = pcall(function()
        return obj[property]
    end)
    if not ok then return end

    if not saved[obj] then
        saved[obj] = {}
    end

    if saved[obj][property] == nil then
        saved[obj][property] = value
    end
end

local function applyObject(obj)
    if obj:IsA("PostEffect") then
        saveProperty(obj, "Enabled")
        obj.Enabled = false

    elseif obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam") then
        saveProperty(obj, "Enabled")
        obj.Enabled = false

    elseif obj:IsA("BasePart") then
        saveProperty(obj, "CastShadow")
        obj.CastShadow = false
    end
end

local function turnOn()
    savedLighting.GlobalShadows = Lighting.GlobalShadows
    savedLighting.EnvironmentDiffuseScale =
        Lighting.EnvironmentDiffuseScale
    savedLighting.EnvironmentSpecularScale =
        Lighting.EnvironmentSpecularScale

    Lighting.GlobalShadows = false
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        applyObject(obj)
    end

    for _, obj in ipairs(Lighting:GetDescendants()) do
        if obj:IsA("PostEffect") then
            applyObject(obj)
        end
    end

    enabled = true
    status.Text = "Status: BOOST ON"
    toggle.Text = "BOOST: ON"
    toggle.BackgroundColor3 = GREEN
end

local function turnOff()
    enabled = false

    for obj, properties in pairs(saved) do
        if obj and obj.Parent then
            for property, value in pairs(properties) do
                pcall(function()
                    obj[property] = value
                end)
            end
        end
    end

    saved = {}

    for property, value in pairs(savedLighting) do
        pcall(function()
            Lighting[property] = value
        end)
    end

    savedLighting = {}

    status.Text = "Status: OFF"
    toggle.Text = "BOOST: OFF"
    toggle.BackgroundColor3 = RED
end

toggle.Activated:Connect(function()
    if enabled then
        turnOff()
    else
        turnOn()
    end
end)

